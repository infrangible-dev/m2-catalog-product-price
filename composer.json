{
    "name": "infrangible/m2-catalog-product-price",
    "description": "Adds custom labels and information texts to product prices (final, old, minimum and maximum price) plus an extra price line such as a recommended retail price, driven by product attributes.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Pricing",
        "Catalog",
        "Hyvä",
        "custom price labels",
        "recommended retail price display",
        "price information texts"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-price",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-bundle": "~101.0.0",
        "magento/module-catalog": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-configurable-product": "~100.4.0",
        "magento/module-eav": "~102.1.0",
        "magento/module-swatches": "~100.4.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPrice\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}
